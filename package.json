{
  "name": "playwrighttest",
  "version": "1.0.0",
  "description": "This framework is developed for students to understand Playwright frameworks",
  "main": "index.js",
  "scripts": {
    "demo": "playwright test --headed ../tests/demo/mytest.spec.ts",
    "login": "npx playwright test --headed ../tests/functional/login.spec.ts",
    "make-apt": "npx playwright test --headed ../tests/functional/make.apt.spec.ts",
    "ele-init": "npx playwright test --headed ../tests/demo/ele.handling.spec.ts",
    "inventory": "npx playwright test --headed ../tests/functional/inventory.spec.ts",
    "debug": "npx playwright test --headed ../tests/demo/debug.make.apt.spec.ts --debug",
    "debug_ui": "npx playwright test --headed ../tests/demo/debug.make.apt.spec.ts --debug --ui",
    "debug_cli": "set PWDEBUG=1&& npx playwright test ../tests/demo/debug.make.apt.spec.ts",
    "debug_trace": "npx playwright test ../tests/demo/debug.make.apt.spec.ts --trace on --headed",
    "pw-basic-cap": "npx playwright test ../tests/demo/pw.basic.cap.make.apt.spec.ts --headed",
    "pw-adv-cap": "npx playwright test ../tests/demo/pw.adv.cap.make.apt.spec.ts --headed",
    "hooks:demo": "playwright test --headed ../tests/demo/hooks.demo.spec.ts",
    "demo:global": "playwright test --headed ../tests/demo/hooks.demo.spec.ts",
    "demo:params": "npx playwright test --headed ../tests/demo/params.make.apt.spec.ts",
    "test:make-apt": "npx playwright test --headed --config=config/test.config.playwright.ts ../tests/functional/make.apt.spec.ts",
    "dev:make-apt": "npx playwright test --headed --config=config/dev.config.playwright.ts ../tests/functional/make.apt.spec.ts",
    "e2e": "npx playwright test --headed --config=config/test.config.playwright.ts tests/e2e/nopcommerce.e2e.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrawalhemant5393/PlaywrightTest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/agrawalhemant5393/PlaywrightTest/issues"
  },
  "homepage": "https://github.com/agrawalhemant5393/PlaywrightTest#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-playwright": "^3.10.2",
    "chalk": "^5.6.2",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "path": "^0.12.7"
  }
}
